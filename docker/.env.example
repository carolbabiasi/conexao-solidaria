# Copie este arquivo para .env antes de subir o compose:
#
#   cp .env.example .env
#
# O .env NAO vai para o Git (esta no .gitignore) porque guarda senhas.
# Estas credenciais sao apenas para desenvolvimento local. Em Kubernetes
# elas vem de um Secret (ver K8S-04).

# ---------------------------------------------------------- PostgreSQL
POSTGRES_USER=gestorong
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=conexaosolidaria
POSTGRES_PORT=5432

# ---------------------------------------------------------- MongoDB
MONGO_USER=gestorong
MONGO_PASSWORD=troque-esta-senha
MONGO_DB=conexaosolidaria
MONGO_PORT=27017

# ---------------------------------------------------------- RabbitMQ
RABBITMQ_USER=gestorong
RABBITMQ_PASSWORD=troque-esta-senha
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ---------------------------------------------------------- Prometheus
PROMETHEUS_PORT=9090

# ---------------------------------------------------------- Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=troque-esta-senha
GRAFANA_PORT=3000
